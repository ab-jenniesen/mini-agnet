# First startup defaults to DeepSeek. Add only keys for providers you plan to use.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
KIMI_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
GROQ_API_KEY=
# OLLAMA_API_KEY=ollama
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://127.0.0.1:8000/v1
# AGENT_WORKSPACE=/absolute/path/to/project
AGENT_SESSION_ID=default
# Optional: require plan approval before entering the execution workflow.
AGENT_CONFIRM_PLAN=0
# Default state stays in the launch project's .mini-agent directory.
# AGENT_MEMORY_FILE=/absolute/path/to/memories.json
# AGENT_MODEL_STATE_FILE=/absolute/path/to/model-selection.json
# MCP_COMMAND=node
# MCP_ARGS_JSON=["/absolute/path/to/server.js"]

# Optional: request visible provider thinking (supported models only)
# AGENT_ANTHROPIC_THINKING_BUDGET=2048
# AGENT_GEMINI_THOUGHTS=1

# Context engineering (approximate token estimates)
AGENT_CONTEXT_SUMMARIZE=0

# Total context defaults to 128k (131072 tokens), including reserved output.
AGENT_CONTEXT_WINDOW_OVERRIDE=131072
# AGENT_OUTPUT_RESERVE=8192
AGENT_COMPACT_THRESHOLD=0.8
# AGENT_ARTIFACT_DIR=/absolute/path/to/artifacts
AGENT_MAX_INPUT_CHARS=65536

# Pi TUI uses a scrollable alternate screen by default; regular keeps terminal scrollback.
# AGENT_TUI_SCREEN=regular
# Completed tool records shown per conversation turn; older records stay in session history.
AGENT_TUI_MAX_TOOL_ENTRIES=5
# HTTP/SSE host (npm run server)
# AGENT_SERVER_PORT=3000
# AGENT_SERVER_TOKEN=choose-a-long-random-value
# AGENT_CLIENT_ORIGIN=http://localhost:5173
