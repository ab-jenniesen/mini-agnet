# First startup defaults to DeepSeek. Add only keys for providers you plan to use.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
KIMI_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
GROQ_API_KEY=
# OLLAMA_API_KEY=ollama
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://127.0.0.1:8000/v1
AGENT_WORKSPACE=./workspace
AGENT_SESSION_ID=default
AGENT_MEMORY_FILE=.agent-state/memories.json
AGENT_MODEL_STATE_FILE=.agent-state/model-selection.json
AGENT_MAX_STEPS=15
# MCP_COMMAND=node
# MCP_ARGS_JSON=["/absolute/path/to/server.js"]

# Optional: request visible provider thinking (supported models only)
# AGENT_ANTHROPIC_THINKING_BUDGET=2048
# AGENT_GEMINI_THOUGHTS=1

# Context engineering (approximate token estimates)
AGENT_CONTEXT_SUMMARIZE=0

# Context is obtained from provider model metadata if available. Override when missing.
# AGENT_CONTEXT_WINDOW_OVERRIDE=131072
# AGENT_OUTPUT_RESERVE=8192
AGENT_COMPACT_THRESHOLD=0.8
AGENT_ARTIFACT_DIR=.agent-state/artifacts
AGENT_MAX_INPUT_CHARS=65536
# Context capacity without verified metadata falls back to 32768, flagged as UNVERIFIED.
